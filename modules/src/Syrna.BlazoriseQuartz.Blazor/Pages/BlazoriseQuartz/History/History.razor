@page "/history"
@using Blazorise.DataGrid
@using Syrna.BlazoriseQuartz.Blazor.Services
@using Syrna.BlazoriseQuartz.ExecutionLog.Dtos
@using Syrna.BlazoriseQuartz.Blazor.Components
@using Syrna.BlazoriseQuartz.Localization

@inject AbpBlazorMessageLocalizerHelper<BlazoriseQuartzResource> LH
@inherits Volo.Abp.AspNetCore.Components.AbpComponentBase
<PageTitle>@L["Title:History"]</PageTitle>

<Offcanvas @bind-Visible="@_openFilter" Placement="Placement.End">
    <OffcanvasHeader>
        <Heading Size="HeadingSize.Is6">@L["Filter:FilterLogs"]</Heading>
    </OffcanvasHeader>
    <OffcanvasBody>
        <Column>
            <Field>
                <FieldLabel>@L["Filter:JobGroup"]</FieldLabel>
                <FieldBody>
                    <Select TValue="string"
                            SelectedValue="@_filter.JobGroup"
                            SelectedValueChanged="OnFilterJobGroupChanged">
                        @foreach (var group in _jobGroups)
                        {
                            if (string.IsNullOrEmpty(group))
                            {
                                <SelectItem TValue="string" Value="@(string.Empty)">@L["EmptySelectItem"]</SelectItem>
                                continue;
                            }
                            <SelectItem TValue="string" Value="@group">@group</SelectItem>
                        }
                    </Select>
                </FieldBody>
            </Field>

            <Field>
                <FieldLabel>@L["Filter:JobName"]</FieldLabel>
                <FieldBody>
                    <Select TValue="string"
                            SelectedValue="@_filter.JobName"
                            SelectedValueChanged="OnFilterJobNameChanged">
                        @foreach (var name in _jobNames)
                        {
                            if (string.IsNullOrEmpty(name))
                            {
                                <SelectItem TValue="string" Value="@(string.Empty)">@L["EmptySelectItem"]</SelectItem>
                                continue;
                            }
                            <SelectItem TValue="string" Value="@name">@name</SelectItem>
                        }
                    </Select>
                </FieldBody>
            </Field>

            <Field>
                <FieldLabel>@L["Filter:TriggerGroup"]</FieldLabel>
                <FieldBody>
                    <Select TValue="string"
                            SelectedValue="@_filter.TriggerGroup"
                            SelectedValueChanged="OnFilterTriggerGroupChanged">
                        @foreach (var group in _triggerGroups)
                        {
                            if (string.IsNullOrEmpty(group))
                            {
                                <SelectItem TValue="string" Value="@(string.Empty)">@L["EmptySelectItem"]</SelectItem>
                                continue;
                            }
                            <SelectItem TValue="string" Value="@group">@group</SelectItem>
                        }
                    </Select>
                </FieldBody>
            </Field>

            <Field>
                <FieldLabel>@L["Filter:TriggerName"]</FieldLabel>
                <FieldBody>
                    <Select TValue="string"
                            SelectedValue="@_filter.TriggerName"
                            SelectedValueChanged="OnFilterTriggerNameChanged">
                        @foreach (var name in _triggerNames)
                        {
                            if (string.IsNullOrEmpty(name))
                                continue;
                            <SelectItem TValue="string" Value="@name">@name</SelectItem>
                        }
                    </Select>
                </FieldBody>
            </Field>

            <Field>
                <FieldLabel>@L["Filter:LogTypes"]</FieldLabel>
                <FieldBody>
                    <Select TValue="LogType?"
                            SelectedValue="_selectedLogType"
                            SelectedValueChanged="OnSelectedLogTypesChanged">
                        <SelectItem TValue="LogType?" Value="LogType.ScheduleJob">Jobs</SelectItem>
                        <SelectItem TValue="LogType?" Value="LogType.Trigger">Triggers</SelectItem>
                        <SelectItem TValue="LogType?" Value="LogType.System">System/Scheduler</SelectItem>
                    </Select>
                </FieldBody>
            </Field>

            <Check Checked="@_filter.ErrorOnly"
                   TValue="bool"
                   CheckedChanged="OnErrorOnlyChanged">@L["Filter:ErrorOnly"]</Check>

            <Field>
                <FieldLabel></FieldLabel>
                <FieldBody>
                    <Check Checked="@_filter.IncludeSystemJobs"
                           TValue="bool"
                           CheckedChanged="OnIncludeSystemJobsChanged">@L["Filter:IncludeSystemJobs"]</Check>
                </FieldBody>
            </Field>
        </Column>
        <Column>
            <Button Clicked="OnCancelFilter">@L["Cancel"]</Button>
            <div class="d-flex gap-2">
                <Button Color="Color.Secondary" Clicked="OnClearFilter">@L["Clear"]</Button>
                <Button Color="Color.Primary" Clicked="OnSaveFilter">@L["Save"]</Button>
            </div>
        </Column>
    </OffcanvasBody>
</Offcanvas>

<Bar Breakpoint="Breakpoint.Desktop" Background="Background.Light" Shadow="Shadow.Remove" ThemeContrast="ThemeContrast.Light">
    <BarBrand>
        <Heading Size="HeadingSize.Is4">@L["Title:History"]</Heading>
    </BarBrand>
    <BarStart>
    </BarStart>
    <BarEnd>
        <Addons>
            <Addon AddonType="AddonType.Start">
                <Icon IconSize="IconSize.Default" Name="@IconName.Search" Margin="Margin.Is2"></Icon>
            </Addon>
            <Addon AddonType="AddonType.Body">
                <TextEdit TextChanged="@OnSearch" Placeholder="Search"></TextEdit>
            </Addon>
            <Addon AddonType="AddonType.End">
                <Icon IconSize="IconSize.Default" Name="@IconName.Sync" Clicked="RefreshLogs" Margin="Margin.Is2"></Icon>
                <Icon IconSize="IconSize.Default" Name="@IconName.SearchPlus" Clicked="OnFilterClicked" Margin="Margin.Is2"></Icon>
            </Addon>
        </Addons>
    </BarEnd>
</Bar>
<DataGrid @ref="table"
          TItem="ExecutionLogDto"
          Data="@pagedData"
          ReadData="@OnReadData"
          TotalItems="@totalItems"
          PageSize="@pageSize"
          Editable="false"
          ShowPager
          FixedHeader
          Hoverable
          Responsive
          Striped>
    <LoadingTemplate>
        <Row Class="w-100 align-items-center" Style="height: 250px;">
            <Column>
                <RadarSpinner />
            </Column>
        </Row>
    </LoadingTemplate>
    <EmptyTemplate>
        <Row Class="w-100 align-items-center" Style="height: 250px;">
            <Column>
                <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">No data available</Heading>
            </Column>
        </Row>
    </EmptyTemplate>
    <DataGridColumns>
        <DataGridColumn Width="30px">
            <DisplayTemplate>
                @{
                    var iconAndColor = GetLogIconAndColor(context);
                }
                <Icon Name="@iconAndColor.Item1" TextColor="@iconAndColor.Item2" title="@iconAndColor.Item3" IconSize="IconSize.Default" />
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridDateColumn Field="@nameof(ExecutionLogDto.DateAddedUtc)" Caption="@L["ExecutionLog:DateAddedUtc"]" Width="160px">
            <DisplayTemplate>
                @context.DateAddedUtc.ToLocalTime().ToString("G")
            </DisplayTemplate>
        </DataGridDateColumn>
        <DataGridColumn Field="@nameof(ExecutionLogDto.JobName)" Caption="@L["ExecutionLog:JobName"]"></DataGridColumn>
        <DataGridColumn Field="@nameof(ExecutionLogDto.JobGroup)" Caption="@L["ExecutionLog:JobGroup"]"></DataGridColumn>
        <DataGridColumn Field="@nameof(ExecutionLogDto.TriggerName)" Caption="@L["ExecutionLog:TriggerName"]"></DataGridColumn>
        <DataGridColumn Field="@nameof(ExecutionLogDto.ErrorMessage)" Caption="@L["ExecutionLog:ErrorMessage"]" Width="30vw">
            <DisplayTemplate>
                <div>
                    <Text TextColor="TextColor.Dark">
                        @if (context.IsException ?? false)
                        {
                            @context.GetShortExceptionMessage()
                            ;
                        }
                        else
                        {
                            @context.GetShortResultMessage()
                            ;
                        }
                    </Text>
                    @if (context.IsException ?? false)
                    {
                        <Button Size="Size.Default"
                                Clicked="@(async () => await OnMoreDetails(context, "Error Details"))"
                                Color="Color.Link">
                            @L["ExecutionLog:ErrorDetails"]
                        </Button>
                    }
                    else if (context.ShowExecutionDetailButton())
                    {
                        <Button Size="Size.Default"
                                Clicked="@(async () => await OnMoreDetails(context, "Execution Details"))"
                                Color="Color.Link">
                            @L["ExecutionLog:ExecutionDetails"]
                        </Button>
                    }
                </div>
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridDateColumn Field="@nameof(ExecutionLogDto.ScheduleFireTimeUtc)" Caption="@L["ExecutionLog:ScheduleFireTimeUtc"]" Width="160px"></DataGridDateColumn>
        <DataGridDateColumn Field="@nameof(ExecutionLogDto.FireTimeUtc)" Caption="@L["ExecutionLog:FireTimeUtc"]" Width="160px"></DataGridDateColumn>
        <DataGridColumn Field="@nameof(ExecutionLogDto.JobRunTime)" Caption="@L["ExecutionLog:JobRunTime"]" Width="120px">
            <DisplayTemplate>@context.JobRunTime?.ToHumanTimeString()</DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>
</DataGrid>
<ExecutionDetailsDialog @ref="ExecutionDetailsDialogRef"></ExecutionDetailsDialog>